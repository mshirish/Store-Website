SECRET_KEY=replace-me-with-a-long-random-string
DEBUG=True

# ── Hosts & CSRF ──────────────────────────────────────────────────────────────
# Comma-separated list of hostnames/IPs Django will serve.
# LOCAL DEV:  ALLOWED_HOSTS=localhost,127.0.0.1
# AWS (HTTP): ALLOWED_HOSTS=localhost,127.0.0.1,<alb-dns-name>,<ec2-private-ip>
#   e.g.      ALLOWED_HOSTS=localhost,my-alb-123456.us-east-1.elb.amazonaws.com,10.0.1.5
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated full origins (scheme+host) that may POST forms through a
# reverse proxy. Required for login, checkout, and admin POST requests via ALB.
# LOCAL DEV:  CSRF_TRUSTED_ORIGINS=http://localhost,http://localhost:8000
# AWS (HTTP): CSRF_TRUSTED_ORIGINS=http://<alb-dns-name>
#   e.g.      CSRF_TRUSTED_ORIGINS=http://my-alb-123456.us-east-1.elb.amazonaws.com
CSRF_TRUSTED_ORIGINS=http://localhost,http://localhost:8000

# ── Reverse-proxy / HTTPS ─────────────────────────────────────────────────────
# Set true when running behind an ALB or nginx (EC2/AWS).
USE_X_FORWARDED_HOST=false

# HTTP lab (default): leave HTTPS_PROXY unset or false. All secure-cookie and
# SSL-redirect settings stay off so HTTP works correctly.
# HTTPS_PROXY=false
# SECURE_SSL_REDIRECT=false
# SESSION_COOKIE_SECURE=false
# CSRF_COOKIE_SECURE=false

# ── Database ──────────────────────────────────────────────────────────────────
# The Django app reads only DATABASE_URL. Set it to a full Postgres connection
# string for whichever environment you're in.
#
# LOCAL DEV (Docker Compose):
#   docker-compose.yml overrides DATABASE_URL automatically using the DB_*
#   vars below — you do NOT need to change DATABASE_URL when using Compose.
#
# AWS (EC2 + RDS):
#   Set DATABASE_URL directly to your RDS endpoint:
#   DATABASE_URL=postgres://<db-user>:<db-password>@<rds-endpoint>:5432/<db-name>
#   e.g. DATABASE_URL=postgres://store_user:s3cr3t@store.cxyz.us-east-1.rds.amazonaws.com:5432/store_db
#
# Individual components used only by docker-compose.yml (not read by Django):
DB_NAME=store_db
DB_USER=store_user
DB_PASSWORD=changeme
DB_PORT=5432

DATABASE_URL=postgres://store_user:changeme@localhost:5432/store_db

# ── Email ─────────────────────────────────────────────────────────────────────
# Leave EMAIL_HOST blank to print emails to the terminal (console backend).
# Fill in SMTP credentials to send real emails.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Our Store <noreply@example.com>

# ── Auth ──────────────────────────────────────────────────────────────────────
# 'none'      — skip email verification (fast dev testing, no SMTP needed)
# 'mandatory' — require email verification before login (use in production)
ACCOUNT_EMAIL_VERIFICATION=none

# ── Stripe (test mode) ────────────────────────────────────────────────────────
# Get keys from https://dashboard.stripe.com/test/apikeys
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
# Webhook secret — see DEPLOY-AWS.md for registering the ALB URL in Stripe
STRIPE_WEBHOOK_SECRET=whsec_...
